# =============================================================================
# DevPilot - example environment file
#
# Copy to `.env` and fill in real values:  cp .env.example .env
# `.env` is git-ignored. Never commit real secrets.
#
# Every variable below is consumed by backend/app/core/config.py (Settings).
# =============================================================================

# --- Application ------------------------------------------------------------
# One of: local | ci | production. Controls log format and error verbosity.
DEVPILOT_ENVIRONMENT=local
# Emits human-readable logs and enables /docs. Never enable in production.
DEVPILOT_DEBUG=true
# One of: DEBUG | INFO | WARNING | ERROR | CRITICAL
DEVPILOT_LOG_LEVEL=INFO

# --- PostgreSQL -------------------------------------------------------------
# SQLAlchemy URL. The `psycopg` suffix selects the psycopg 3 driver.
# Host `postgres` is the service name inside Docker Compose; use `localhost`
# when running the API directly on your machine.
DEVPILOT_DATABASE_URL=postgresql+psycopg://devpilot:devpilot@postgres:5432/devpilot

# Consumed by the `postgres` container itself (not by the application).
POSTGRES_USER=devpilot
POSTGRES_PASSWORD=devpilot
POSTGRES_DB=devpilot

# --- Redis ------------------------------------------------------------------
# Broker and result backend for Celery; also backs API rate limiting.
DEVPILOT_REDIS_URL=redis://redis:6379/0

# --- HTTP -------------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API.
DEVPILOT_CORS_ORIGINS=http://localhost:5173

# --- Frontend (build-time, read by Vite) ------------------------------------
# Base URL the browser uses to reach the API. Must be reachable from the
# browser, not from inside the Docker network.
VITE_API_BASE_URL=http://localhost:8000
