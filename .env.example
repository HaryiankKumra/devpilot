# =============================================================================
# DevPilot - example environment file
#
# Copy to `.env` and fill in real values:  cp .env.example .env
# `.env` is git-ignored. Never commit real secrets.
#
# Every variable below is consumed by backend/app/core/config.py (Settings).
# =============================================================================

# --- Application ------------------------------------------------------------
# One of: local | ci | production. Controls log format and error verbosity.
DEVPILOT_ENVIRONMENT=local
# Emits human-readable logs and enables /docs. Never enable in production.
DEVPILOT_DEBUG=true
# One of: DEBUG | INFO | WARNING | ERROR | CRITICAL
DEVPILOT_LOG_LEVEL=INFO

# --- Authentication ---------------------------------------------------------
# Signs access tokens. The value below is a well-known placeholder that works
# for local development only: the application REFUSES TO START in production
# while it is still set, because anyone who knows it can mint a token for any
# account.
#
# Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
DEVPILOT_SECRET_KEY=insecure-development-secret-key-do-not-use-in-production

# How long an access token stays valid. Tokens cannot be revoked before they
# expire, so this is the window during which a leaked token remains usable --
# keep it short. See docs/engineering-tradeoffs.md.
DEVPILOT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Background workers -----------------------------------------------------
# Celery shares the Redis server but uses separate logical databases, so
# flushing the cache never destroys the queue.
DEVPILOT_CELERY_BROKER_DB=1
DEVPILOT_CELERY_RESULT_DB=2

# The soft limit arrives as a catchable exception so the job can record why it
# timed out; the hard limit kills the process and must be larger.
DEVPILOT_CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=600
DEVPILOT_CELERY_TASK_TIME_LIMIT_SECONDS=660

# Retry backoff for transient failures: 30s, 60s, 120s, capped at 600s.
# A GitHub rate limit overrides this with GitHub's own Retry-After.
DEVPILOT_CELERY_RETRY_BACKOFF_SECONDS=30
DEVPILOT_CELERY_RETRY_BACKOFF_MAX_SECONDS=600

# --- Language model ---------------------------------------------------------
# Which provider produces reviews. One of:
#
#   mock       No API key, no cost, no network. Restates static-analysis output
#              and labels every summary "[Mock review ...]", so a mocked review
#              can never be mistaken for a real one. This is the default.
#   gemini     Google Gemini. Has a free tier -- the option to pick if you do
#              not want to spend money.
#   anthropic  Claude. Best quality here, but billed per review.
#
# Full walkthrough for both: docs/llm-setup.md
DEVPILOT_LLM_MODE=mock

# --- Gemini (free tier) ---
# One or more keys, comma-separated. Get them at https://aistudio.google.com
#
# The free tier is metered PER KEY, so several keys are rotated round-robin and
# a key that returns 429 is parked until its cool-down expires. One key works
# fine; more simply means more headroom. Only use keys you legitimately hold --
# creating extra accounts to multiply free quota is against Google's terms.
DEVPILOT_GEMINI_API_KEYS=

# --- Anthropic (paid) ---
# Required when LLM_MODE=anthropic. Get one at https://console.anthropic.com
# and set a spend limit while you are there -- it is the only hard stop.
DEVPILOT_ANTHROPIC_API_KEY=

# Leave blank and the model follows the provider: gemini-3.6-flash for Gemini,
# claude-opus-5 for Anthropic. Setting it explicitly always wins.
# Note gemini-2.5-flash is closed to new accounts and answers 404.
DEVPILOT_LLM_MODEL=

# Comma-separated models to try, in order, when the primary answers 5xx. Free-
# tier flash models go "high demand, try later" for minutes at a time, and a
# sibling model is usually fine. Blank follows the provider (gemini-3.5-flash
# for Gemini); a single comma opts out. Only 5xx triggers this -- a rate limit
# is per key and handled by the key pool instead.
DEVPILOT_LLM_FALLBACK_MODELS=

# low | medium | high | xhigh | max. Reviewing code rewards reasoning depth, so
# the default is high; medium is usually enough for routine changes and costs
# meaningfully less. Anthropic only -- Gemini ignores it.
DEVPILOT_LLM_EFFORT=high

# Low, because reviewing code rewards consistency over variety: the same diff
# should not produce a different verdict on a re-run. Not zero, so a validation
# retry has some chance of differing from the attempt it replaces.
DEVPILOT_LLM_TEMPERATURE=0.2

# Hitting this cap truncates the response mid-JSON and wastes the whole call.
DEVPILOT_LLM_MAX_OUTPUT_TOKENS=16000
DEVPILOT_LLM_REQUEST_TIMEOUT_SECONDS=180

# Findings below this confidence are stored and shown on the dashboard, but
# never posted to GitHub. A reviewer that posts its guesses stops being read.
DEVPILOT_LLM_MIN_CONFIDENCE_TO_POST=0.7

# Re-asks when the model returns something unusable. Generation is stochastic,
# so a second attempt genuinely can succeed; a third rarely adds anything.
DEVPILOT_LLM_MAX_VALIDATION_RETRIES=2

# --- Embeddings and retrieval -----------------------------------------------
# `mock` uses deterministic feature hashing: no key, no cost, and distances that
# genuinely mean something -- lexically, not semantically.
DEVPILOT_EMBEDDING_MODE=mock

# Required when EMBEDDING_MODE=live. Anthropic has no embeddings endpoint, so
# retrieval uses Voyage AI: https://dash.voyageai.com
DEVPILOT_VOYAGE_API_KEY=
DEVPILOT_EMBEDDING_MODEL=voyage-code-3

# Must match the code_chunks.embedding column. Changing it needs a migration
# and a full re-index: vectors from two models are not comparable.
DEVPILOT_EMBEDDING_DIMENSIONS=1024

# How many chunks reach the prompt. More is not better: past a handful, the
# relevant chunk competes for attention with near-misses.
DEVPILOT_RETRIEVAL_TOP_K=6
# Cosine distance above this means "not actually related". Without a ceiling a
# search always returns k rows however irrelevant they are.
DEVPILOT_RETRIEVAL_MAX_DISTANCE=0.75
DEVPILOT_MAX_INDEXED_FILES=1000

# --- Review pipeline limits -------------------------------------------------
# A diff beyond these produces a prompt no model reads carefully, so it is
# refused rather than reviewed badly.
DEVPILOT_MAX_DIFF_BYTES=500000
DEVPILOT_MAX_CHANGED_FILES=100
DEVPILOT_MAX_FILE_BYTES=200000

# --- GitHub integration -----------------------------------------------------
# `mock` runs the whole application against an in-process fake GitHub with NO
# credentials at all -- repository sync, webhooks and the dashboard all work.
# Switch to `live` only once you have registered a GitHub App.
# Full walkthrough: docs/github-app-setup.md
DEVPILOT_GITHUB_MODE=mock

# --- Everything below is only needed when GITHUB_MODE=live -------------------

# From the App's settings page (Settings -> Developer settings -> GitHub Apps).
DEVPILOT_GITHUB_APP_ID=
# The URL name of the app, used to build the "Install on a repository" link.
# For https://github.com/apps/my-devpilot this is `my-devpilot`.
DEVPILOT_GITHUB_APP_SLUG=

# The App's RSA private key, downloaded as a .pem when you generate it.
# Either point at the file (easier, and what Docker secret mounts expect):
DEVPILOT_GITHUB_APP_PRIVATE_KEY_PATH=
# ...or paste the PEM inline. Escaped newlines are accepted, since a real PEM
# rarely survives a .env file intact. If both are set, the inline value wins.
DEVPILOT_GITHUB_APP_PRIVATE_KEY=

# The webhook secret you typed when creating the App. Without it EVERY webhook
# is rejected -- which is the correct default, since an unverified webhook is
# unauthenticated input that can create review jobs.
DEVPILOT_GITHUB_WEBHOOK_SECRET=

# OAuth credentials, used only to link a DevPilot account to a GitHub identity.
# Repository access comes from the App installation, not from these.
DEVPILOT_GITHUB_CLIENT_ID=
DEVPILOT_GITHUB_CLIENT_SECRET=

# Must match the callback URL registered on the App, character for character.
DEVPILOT_GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/github/callback
# Where the browser is sent once linking finishes.
DEVPILOT_FRONTEND_BASE_URL=http://localhost:5173

# --- PostgreSQL -------------------------------------------------------------
# SQLAlchemy URL. The `psycopg` suffix selects the psycopg 3 driver.
# Host `postgres` is the service name inside Docker Compose; use `localhost`
# when running the API directly on your machine.
DEVPILOT_DATABASE_URL=postgresql+psycopg://devpilot:devpilot@postgres:5432/devpilot

# Connection-pool tuning. The timeouts matter more than the sizes: they turn
# "the database is down" into a fast 503 rather than a request that hangs until
# the client gives up.
DEVPILOT_DB_POOL_SIZE=5
DEVPILOT_DB_MAX_OVERFLOW=10
DEVPILOT_DB_POOL_TIMEOUT_SECONDS=5
DEVPILOT_DB_CONNECT_TIMEOUT_SECONDS=3
DEVPILOT_DB_STATEMENT_TIMEOUT_MS=10000

# Consumed by the `postgres` container itself (not by the application).
POSTGRES_USER=devpilot
POSTGRES_PASSWORD=devpilot
POSTGRES_DB=devpilot

# --- Redis ------------------------------------------------------------------
# Broker and result backend for Celery; also backs API rate limiting.
DEVPILOT_REDIS_URL=redis://redis:6379/0
DEVPILOT_REDIS_SOCKET_TIMEOUT_SECONDS=2

# --- HTTP -------------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API.
DEVPILOT_CORS_ORIGINS=http://localhost:5173

# --- Rate limiting ----------------------------------------------------------
# Counters live in Redis, so every API replica shares one allowance. Set to
# false to measure raw capacity in a load test; leave it on everywhere else.
DEVPILOT_RATE_LIMIT_ENABLED=true

# General API allowance, per client per window. Keyed on the authenticated user
# when the request carries a valid token, on client IP otherwise.
DEVPILOT_RATE_LIMIT_REQUESTS=300

# Login and registration get their own, much tighter allowance: that is where
# credential stuffing happens, and Argon2 makes every attempt expensive for the
# server as well as the attacker.
DEVPILOT_RATE_LIMIT_AUTH_REQUESTS=10

DEVPILOT_RATE_LIMIT_WINDOW_SECONDS=60

# --- HTTP security ----------------------------------------------------------
# Set to true ONLY when the API sits behind a proxy that overwrites
# X-Forwarded-For. The header is client-supplied, so trusting it anywhere else
# lets a caller reset its own rate limit by inventing an address.
DEVPILOT_TRUST_PROXY_HEADERS=false

# Send Strict-Transport-Security. Enable in production behind real TLS only:
# a browser that receives it from localhost will refuse plain HTTP to localhost
# for the whole max-age, for every project on that machine.
DEVPILOT_ENABLE_HSTS=false

# --- Frontend (build-time, read by Vite) ------------------------------------
# Base URL the browser uses to reach the API. Must be reachable from the
# browser, not from inside the Docker network.
VITE_API_BASE_URL=http://localhost:8000
