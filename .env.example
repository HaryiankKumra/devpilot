# =============================================================================
# DevPilot - example environment file
#
# Copy to `.env` and fill in real values:  cp .env.example .env
# `.env` is git-ignored. Never commit real secrets.
#
# Every variable below is consumed by backend/app/core/config.py (Settings).
# =============================================================================

# --- Application ------------------------------------------------------------
# One of: local | ci | production. Controls log format and error verbosity.
DEVPILOT_ENVIRONMENT=local
# Emits human-readable logs and enables /docs. Never enable in production.
DEVPILOT_DEBUG=true
# One of: DEBUG | INFO | WARNING | ERROR | CRITICAL
DEVPILOT_LOG_LEVEL=INFO

# --- Authentication ---------------------------------------------------------
# Signs access tokens. The value below is a well-known placeholder that works
# for local development only: the application REFUSES TO START in production
# while it is still set, because anyone who knows it can mint a token for any
# account.
#
# Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
DEVPILOT_SECRET_KEY=insecure-development-secret-key-do-not-use-in-production

# How long an access token stays valid. Tokens cannot be revoked before they
# expire, so this is the window during which a leaked token remains usable --
# keep it short. See docs/engineering-tradeoffs.md.
DEVPILOT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- PostgreSQL -------------------------------------------------------------
# SQLAlchemy URL. The `psycopg` suffix selects the psycopg 3 driver.
# Host `postgres` is the service name inside Docker Compose; use `localhost`
# when running the API directly on your machine.
DEVPILOT_DATABASE_URL=postgresql+psycopg://devpilot:devpilot@postgres:5432/devpilot

# Connection-pool tuning. The timeouts matter more than the sizes: they turn
# "the database is down" into a fast 503 rather than a request that hangs until
# the client gives up.
DEVPILOT_DB_POOL_SIZE=5
DEVPILOT_DB_MAX_OVERFLOW=10
DEVPILOT_DB_POOL_TIMEOUT_SECONDS=5
DEVPILOT_DB_CONNECT_TIMEOUT_SECONDS=3
DEVPILOT_DB_STATEMENT_TIMEOUT_MS=10000

# Consumed by the `postgres` container itself (not by the application).
POSTGRES_USER=devpilot
POSTGRES_PASSWORD=devpilot
POSTGRES_DB=devpilot

# --- Redis ------------------------------------------------------------------
# Broker and result backend for Celery; also backs API rate limiting.
DEVPILOT_REDIS_URL=redis://redis:6379/0
DEVPILOT_REDIS_SOCKET_TIMEOUT_SECONDS=2

# --- HTTP -------------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API.
DEVPILOT_CORS_ORIGINS=http://localhost:5173

# --- Frontend (build-time, read by Vite) ------------------------------------
# Base URL the browser uses to reach the API. Must be reachable from the
# browser, not from inside the Docker network.
VITE_API_BASE_URL=http://localhost:8000
